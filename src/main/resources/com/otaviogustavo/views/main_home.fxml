<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" spacing="20" fx:controller="com.otaviogustavo.controllers.MainHomeController">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>
    <Label text="Bem-vindo ao Baroness" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
    <Label text="Reproduções recentes" style="-fx-text-fill: #b3b3b3; -fx-font-size: 20px; -fx-font-weight: bold;"/>
    
    <TableView fx:id="tabelaHistorico" VBox.vgrow="ALWAYS" styleClass="musica-table">
        <columns>
            <TableColumn fx:id="colPlay" prefWidth="60" sortable="false" />
            <TableColumn fx:id="colTitulo" text="TÍTULO" prefWidth="250" />
            <TableColumn fx:id="colArtista" text="ARTISTA" prefWidth="200" />
            <TableColumn fx:id="colAlbum" text="ÁLBUM" prefWidth="200" />
            <TableColumn fx:id="colDuracao" text="DURAÇÃO" prefWidth="100" />
            <TableColumn fx:id="colAdd" prefWidth="60" sortable="false" />
        </columns>
    </TableView>
</VBox>