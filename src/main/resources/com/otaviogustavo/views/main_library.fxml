<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" spacing="20">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>
   <HBox alignment="CENTER_LEFT">
        <Label text="Sua Biblioteca" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
        <Pane HBox.hgrow="ALWAYS" />
        <Button text="Adicionar pasta"/>
    </HBox>
</VBox>
