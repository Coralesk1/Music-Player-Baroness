<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.image.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/26"
  xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.otaviogustavo.controllers.MainController">
  <left>
    <VBox prefWidth="300" spacing="10" style="-fx-background-color: #202020ff" alignment="TOP_CENTER">
      <padding>
        <Insets top="20" right="10" bottom="10" left="10"/>
      </padding>

      <HBox spacing="10">
        <ImageView fitWidth="32" preserveRatio="true">
          <image>
            <Image url="@../images/icons/baroness.png"/>
          </image>
        </ImageView>

        <Label text="Baroness" styleClass="label-title"/>
      </HBox>

      <VBox spacing="10">
        <fx:define>
          <ToggleGroup fx:id="menuGroup"/>
        </fx:define>
        <ToggleButton fx:id="btnHome" text="Início" maxWidth="Infinity" styleClass="button-menu" alignment="CENTER_LEFT" toggleGroup="$menuGroup" selected="true" onAction="#handleMenuAction">
          <graphic>
            <FontIcon iconLiteral="ion4-md-home" iconSize="20"/>
          </graphic>
        </ToggleButton>
        <ToggleButton fx:id="btnLibrary" text="Sua Biblioteca" maxWidth="Infinity" styleClass="button-menu" alignment="CENTER_LEFT" toggleGroup="$menuGroup" onAction="#handleMenuAction">
          <graphic>
            <FontIcon iconLiteral="ion4-md-albums" iconSize="20"/>
          </graphic>
        </ToggleButton>
        <VBox spacing="5" style="-fx-padding: 10 0 0 0;">
           <Button fx:id="btnNewPlaylist" text="Nova Playlist" maxWidth="Infinity" styleClass="button-menu" alignment="CENTER_LEFT" onAction="#handleNewPlaylistAction">
             <graphic>
               <FontIcon iconLiteral="ion4-md-add" iconSize="20"/>
             </graphic>
           </Button>
           <Label text="Playlists" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 10 0 5 15;"/>
           <ComboBox fx:id="comboPlaylists" promptText="Selecionar Playlist" maxWidth="Infinity" styleClass="combo-playlists"/>
        </VBox>
      </VBox>
    </VBox>
  </left>

  <center>
    <StackPane fx:id="centerStack" style="-fx-background-color: #272727ff;">
      <children>
        <VBox fx:id="contentArea">
        </VBox>
        
        <!-- Slide-up Panel -->
        <VBox fx:id="slidingPanel" visible="false" maxHeight="Infinity" styleClass="sliding-panel" StackPane.alignment="BOTTOM_CENTER">
          <children>
            <VBox spacing="10" style="-fx-padding: 20px;" alignment="CENTER_LEFT">
              <children>
                <Label text="Fila de Reprodução" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px; -fx-padding: 0 0 10 0;"/>
                <Label text="Próxima música:" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px;"/>
                <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #282828; -fx-padding: 15px; -fx-background-radius: 8px;" maxWidth="Infinity">
                  <children>
                    <Rectangle width="40" height="40" fill="#FF1493"/>
                    <VBox spacing="3">
                      <children>
                        <Label text="Fila de reprodução vazia" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                        <Label text="A reprodução seguirá a ordem da biblioteca." style="-fx-text-fill: #b3b3b3; -fx-font-size: 11px;"/>
                      </children>
                    </VBox>
                  </children>
                </HBox>
              </children>
            </VBox>
          </children>
        </VBox>
      </children>
    </StackPane>
  </center>

  <bottom>
    <GridPane prefHeight="80" hgap="20" vgap="20" style="-fx-background-color: #272727ff; -fx-padding: 10px" alignment="CENTER_LEFT">
      <columnConstraints>

        <ColumnConstraints percentWidth="25"/>
        <ColumnConstraints percentWidth="50" />
        <ColumnConstraints percentWidth="25"/>

      </columnConstraints>

      <HBox spacing="10" alignment="CENTER_LEFT" GridPane.columnIndex="0" GridPane.rowIndex="0">
        <Rectangle width="32" height="32" fill="green"/>
        <VBox alignment="CENTER_LEFT">
          <Label fx:id="lblTitulo" text="Selecione uma música" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
          <Label fx:id="lblArtista" text="Artista" style="-fx-text-fill: white; -fx-font-size: 11px;"/>
        </VBox>
      </HBox>

      <VBox spacing="5" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="0">
        <HBox styleClass="player-controls-container" spacing="10" alignment="CENTER" maxWidth="Infinity">
          <!-- Botão Voltar -->
          <Button fx:id="btnPrevious" styleClass="button-player" onAction="#handlePreviousAction">
            <graphic>
              <FontIcon iconLiteral="ion4-ios-skip-backward" iconSize="20"/>
            </graphic>
          </Button>
          <!-- Botão Play -->
          <ToggleButton fx:id="btnPlay" styleClass="button-player" onAction="#handlePlayAction">
            <graphic>
              <FontIcon fx:id="iconPlay" iconLiteral="ion4-ios-play" iconSize="24"/>
            </graphic>
          </ToggleButton>
          <!-- Botão Avançar -->
          <Button fx:id="btnNext" styleClass="button-player" onAction="#handleNextAction">
            <graphic>
              <FontIcon iconLiteral="ion4-ios-skip-forward" iconSize="20"/>
            </graphic>
          </Button>
        </HBox>
        <HBox spacing="10" alignment="CENTER">
          <Label fx:id="lblTempoAtual" text="00:00" style="-fx-text-fill: white; -fx-font-size: 11px;"/>
          <Slider fx:id="sliderTime" HBox.hgrow="ALWAYS" styleClass="custom-slider" />
          <Label fx:id="lblTempoTotal" text="00:00" style="-fx-text-fill: white; -fx-font-size: 11px;"/>
        </HBox>
      </VBox>

      <HBox spacing="10" alignment="CENTER_RIGHT" GridPane.columnIndex="2" GridPane.rowIndex="0">
        <Button fx:id="btnSilenciar" styleClass="button-player" onAction="#lidarComSilenciar">
          <graphic>
            <FontIcon fx:id="iconVolume" iconLiteral="ion4-ios-volume-high" iconSize="20"/>
          </graphic>
        </Button>
        <Slider fx:id="sliderVolume" prefWidth="100" min="0" max="100" value="100" styleClass="custom-slider"/>
        <ToggleButton fx:id="btnTogglePanel" styleClass="button-player" onAction="#handleTogglePanel">
          <graphic>
            <FontIcon fx:id="iconTogglePanel" iconLiteral="ion4-ios-menu" iconSize="20"/>
          </graphic>
        </ToggleButton>
      </HBox>
    </GridPane>
  </bottom>
</BorderPane>
