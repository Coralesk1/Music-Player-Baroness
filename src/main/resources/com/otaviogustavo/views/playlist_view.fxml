<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" spacing="20" fx:controller="com.otaviogustavo.controllers.MainPlaylistController">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <!-- Cabeçalho da Playlist -->
    <HBox alignment="BOTTOM_LEFT" spacing="10" style="-fx-padding: 0 0 10 0;">
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <Label fx:id="lblPlaylistNome" text="Nome da Playlist" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
            <Label fx:id="lblPlaylistDescricao" text="Descrição da playlist" style="-fx-text-fill: #b3b3b3; -fx-font-size: 14px;"/>
            <Label fx:id="lblPlaylistData" text="Criada em: " style="-fx-text-fill: #727272; -fx-font-size: 12px;"/>
            <Label fx:id="lblPlaylistQuantidade" text="0 músicas" style="-fx-text-fill: #727272; -fx-font-size: 12px;"/>
        </VBox>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="5" prefWidth="250">
            <Label text="Buscar na playlist" style="-fx-text-fill: #b3b3b3; -fx-font-size: 11px;"/>
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="search-container" maxWidth="Infinity">
                <FontIcon iconLiteral="ion4-ios-search" iconSize="20" styleClass="search-icon"/>
                <TextField fx:id="txtBusca" promptText="Título ou artista..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <HBox spacing="15" alignment="BOTTOM_RIGHT">
            <VBox spacing="5">
                <Label text="Gênero" style="-fx-text-fill: #b3b3b3; -fx-font-size: 11px;"/>
                <ComboBox fx:id="comboGenre" prefWidth="130" styleClass="combo-box-ordenacao"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Artista" style="-fx-text-fill: #b3b3b3; -fx-font-size: 11px;"/>
                <ComboBox fx:id="comboArtist" prefWidth="130" styleClass="combo-box-ordenacao"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Álbum" style="-fx-text-fill: #b3b3b3; -fx-font-size: 11px;"/>
                <ComboBox fx:id="comboAlbum" prefWidth="130" styleClass="combo-box-ordenacao"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Ordenar por" style="-fx-text-fill: #b3b3b3; -fx-font-size: 11px;"/>
                <ComboBox fx:id="comboOrdenacao" prefWidth="130" styleClass="combo-box-ordenacao"/>
            </VBox>
        </HBox>
    </HBox>

    <!-- Tabela de Músicas da Playlist -->
    <TableView fx:id="tabelaMusicas" VBox.vgrow="ALWAYS" styleClass="musica-table">
        <columns>
            <TableColumn fx:id="colPlay" prefWidth="50" resizable="false" sortable="false" />
            <TableColumn fx:id="colTitulo" text="Título" prefWidth="300" />
            <TableColumn fx:id="colArtista" text="Artista" prefWidth="150" />
            <TableColumn fx:id="colAlbum" text="Álbum" prefWidth="200" />
            <TableColumn fx:id="colDuracao" text="Duração" prefWidth="80" />
            <TableColumn fx:id="colExcluir" prefWidth="50" resizable="false" sortable="false" />
            </columns>    </TableView>
</VBox>
